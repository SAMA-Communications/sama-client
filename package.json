{
  "name": "sama-client",
  "version": "1.12.0",
  "private": true,
  "description": "SAMA monorepo: web client, SDK, UI kit",
  "license": "MIT",
  "author": "Igor Khomenko",
  "homepage": "https://github.com/SAMA-Communications/sama-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAMA-Communications/sama-client.git"
  },
  "workspaces": [
    "apps/client",
    "packages/sdk",
    "packages/ui-kit"
  ],
  "scripts": {
    "start": "npm run start --workspace=sama",
    "build:sdk": "npm run build --workspace=@sama-communications/sdk",
    "build:ui-kit": "npm run build --workspace=@sama-communications/ui-kit",
    "build:app": "npm run build --workspace=sama",
    "build": "npm run build:sdk && npm run build:ui-kit && npm run build:app",
    "build:dev:sdk": "npm run build:dev --workspace=@sama-communications/sdk",
    "build:dev:ui-kit": "npm run build:dev --workspace=@sama-communications/ui-kit",
    "build:dev:app": "npm run build:dev --workspace=sama",
    "build:dev": "npm run build:dev:sdk && npm run build:dev:ui-kit && npm run build:dev:app",
    "preview": "npm run preview --workspace=sama",
    "test:ui-kit": "npm run test --workspace=@sama-communications/ui-kit"
  },
  "devDependencies": {
    "rimraf": "^6.0.1"
  }
}
