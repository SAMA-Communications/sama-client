{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "skipLibCheck": true,
    "baseUrl": "./src",

    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,

    "paths": {
      "@src": ["."],
      "@src/*": ["./*"],
      "@elements": ["components/elements"],
      "@elements/*": ["components/elements/*"],
      "@composites": ["components/composites"],
      "@composites/*": ["components/composites/*"],
      "@adapters": ["adapters"],
      "@adapters/*": ["adapters/*"],
      "@types": ["types"],
      "@types/*": ["types/*"],
      "@utils": ["utils"],
      "@utils/*": ["utils/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "tests"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
